# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Database Configuration
# For SQLite (default), only DATABASE_TYPE is needed
# For PostgreSQL/MySQL, also set: DATABASE_HOST, DATABASE_PORT, DATABASE_NAME, DATABASE_USER, DATABASE_PASSWORD
DATABASE_TYPE=sqlite

# PostgreSQL Configuration (only needed if DATABASE_TYPE=postgres)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=momento
DATABASE_USER=postgres
DATABASE_PASSWORD=your_database_password_here

# MySQL Configuration (only needed if DATABASE_TYPE=mysql)
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=momento
MYSQL_USER=mysql
MYSQL_PASSWORD=your_mysql_password_here

# Lavalink Configuration
# Password for Lavalink audio server (must match configs/application.yml)
LAVALINK_PASSWORD=youshallnotpass

# Lavalink Server Location (only needed if running external)
LAVALINK_HOST=localhost
LAVALINK_PORT=2333

# Optional: Bot Configuration
# DATABASE_HOST=postgres
# DATABASE_PORT=5432
# LOG_LEVEL=debug
# LOG_LEVEL=info
# LOG_LEVEL=warn
# LOG_LEVEL=error
